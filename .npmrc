# Keep the dependency tree strict: a package may only import what it declares.
strict-peer-dependencies=false
resolution-mode=highest

# Refuse to install on an unsupported runtime rather than warning and carrying
# on. AstraLock-X targets Node 24 LTS (see .nvmrc and package.json engines);
# Node 23 is end-of-life and must not be used.
engine-strict=true
