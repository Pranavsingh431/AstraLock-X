# Line endings are normalised to LF in the repository and in every working tree.
#
# Without this, Git on Windows checks out CRLF while .prettierrc.json pins
# `endOfLine: "lf"`, so `prettier --check` fails on every file on that platform
# alone. Declaring `eol=lf` makes the checkout match the repository rather than
# the host, which also stops CRLF ever being committed.
* text=auto eol=lf

# Binary assets must never be line-ending normalised.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Scripts that the host executes directly need the ending their interpreter
# expects, regardless of the default above.
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Generated: collapsed by default in GitHub diffs.
pnpm-lock.yaml linguist-generated=true
src-tauri/Cargo.lock linguist-generated=true
